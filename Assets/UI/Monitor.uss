.unity-label {
    -unity-font-definition: url("project://database/Assets/UI/Inconsolata/static/Inconsolata-Light.ttf?fileID=12800000&guid=eda7dab7ed8e042a688dd2301b6c76c7&type=3#Inconsolata-Light");
    color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0.74);
    margin-top: 4px;
    margin-right: 4px;
    margin-bottom: 4px;
    margin-left: 4px;
    padding-top: 8px;
    padding-right: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    font-size: 16px;
}

.text-row {
    flex-direction: row;
}

.control-panel {
    position: absolute;
    left: 8px;
    bottom: 8px;
    right: auto;
    top: auto;
    width: 320px;
    background-color: rgba(0, 0, 0, 0.74);
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    flex-direction: column;
    gap: 8px;
}

.control-row {
    flex-direction: row;
    align-items: center;
    gap: 8px;
}

.control-label {
    min-width: 90px;
    color: rgb(255, 255, 255);
}

.control-slider {
    flex-grow: 1;
}

.control-button {
    min-width: 70px;
}

.control-dropdown {
    width: 100%;
}
